{
  "name": "gravitas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:game && npm run docs && npm run manual",
    "build:game": "vite build",
    "docs": "typedoc",
    "preview": "vite preview",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "npm run typecheck --workspaces && tsc -p tsconfig.tools.json && tsc -p tests/browser/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "npm run build:game && npm run manual && playwright test --project=webgl2",
    "test:e2e:webgpu": "npm run build:game && npm run manual && playwright test --project=webgpu",
    "manual": "vitepress build manual",
    "manual:dev": "vitepress dev manual",
    "measure": "npm run build:game && playwright test -c playwright.measure.config.ts",
    "icons": "node scripts/icons.ts",
    "moon-data": "node scripts/moon-data.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/three": "0.187.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.1",
    "markdown-it-mathjax3": "4.3.2",
    "prettier": "3.9.10",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitepress": "1.6.4",
    "vitest": "5.1.0"
  }
}
